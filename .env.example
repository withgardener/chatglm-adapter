# Adapter-side authentication. Use a high-entropy value and share it only with NewAPI.
ADAPTER_INTERNAL_API_KEY=replace-with-at-least-32-random-bytes

# Never put a ChatGLM refresh token in this file. Mount a 0600 secret file instead.
CHATGLM_REFRESH_TOKEN_FILE=/run/secrets/chatglm_refresh_token
CHATGLM_DEVICE_ID_FILE=/data/device-id

# Optional: full Cookie header copied from your own logged-in chatglm.cn session.
# When set, the refresh token is read from this cookie string and the whole
# header (including WAF cookies) is sent upstream; refresh token rotation is
# written back into this file, so mount it writable with mode 0600, uid 10001.
# CHATGLM_COOKIES_FILE=/run/secrets/chatglm_cookies

# Optional: pin the device ID instead of deriving it from the token claim.
# CHATGLM_DEVICE_ID=

# User-Agent sent upstream. Defaults to a current Firefox UA because the
# ChatGLM WAF is known to challenge obvious non-browser clients.
# CHATGLM_USER_AGENT=

# Confirmed from the current ChatGLM Web frontend bundle on 2026-09-10.
CHATGLM_AUTH_REFRESH_URL=https://chatglm.cn/chatglm/user-api/user/refresh
# CHATGLM_CONVERSATION_CREATE_URL=
CHATGLM_CONVERSATION_DELETE_URL=https://chatglm.cn/chatglm/mainchat-api/conversation/delete
CHATGLM_TIME_SYNC_URL=https://chatglm.cn/chatglm/operation-api/config/cur_ts
CHATGLM_STREAM_URL=https://chatglm.cn/chatglm/backend-api/assistant/stream
CHATGLM_ASSISTANT_ID=65940acff94777010aa6b796

# Current frontend transform: synced millisecond time with the second-to-last
# digit replaced by the digit sum minus that digit, modulo 10.
CHATGLM_SIGN_SECRET=8a1317a7468aa3ad86e997d08f3f31cb
CHATGLM_TIMESTAMP_FORMAT=chatglm_checksum

CHATGLM_MODEL_GLM_5_3=glm-5.3
CHATGLM_MODEL_GLM_5_3_FLASH=glm-5.3-flash
UPSTREAM_MAX_CONCURRENCY=1
QUEUE_MAX_WAIT_SECONDS=30
UPSTREAM_REQUEST_TIMEOUT_SECONDS=180
AUTH_REFRESH_SKEW_SECONDS=60
STRICT_PARAMETERS=false
LOG_LEVEL=INFO
